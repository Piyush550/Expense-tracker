{
  "rules": {
    "ledger": {
      ".read": "auth != null && auth.token.email_verified == true",
      "users": {
        "$uid": {
          ".write": "auth != null && auth.token.email_verified == true && auth.uid == $uid",
          ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 24 && newData.child('email').val() == auth.token.email"
        }
      },
      "members": {
        ".write": "auth != null && auth.token.email_verified == true"
      },
      "expenses": {
        ".write": "auth != null && auth.token.email_verified == true"
      },
      "settled": {
        ".write": "auth != null && auth.token.email_verified == true"
      },
      "groups": {
        "$gid": {
          ".write": "auth != null && auth.token.email_verified == true",
          ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 40 && newData.hasChild('members')"
        }
      }
    }
  }
}
