{
  "name": "expense-tracker",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.12.2"
  },
  "scripts": {
    "dev": "netlify dev",
    "dev:local": "concurrently -k -n api,auth,web -c blue,yellow,green \"npm:dev:local:api\" \"npm:dev:local:auth\" \"npm:dev:local:web\"",
    "dev:local:api": "tsx watch scripts/local-api.ts",
    "dev:local:auth": "firebase emulators:start --only auth --project demo-expense-tracker",
    "dev:local:web": "vite --mode offline",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:firebase": "tsx scripts/import-firebase.ts",
    "seed:local": "tsx scripts/seed-local.ts",
    "seed:local:user": "tsx scripts/seed-local-user.ts",
    "ci": "tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.2",
    "@tanstack/query-sync-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "firebase": "^13.0.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "firebase-tools": "^15.34.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
